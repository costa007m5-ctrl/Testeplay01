# ============================================================
# NetPlay — Variáveis de Ambiente para Produção (aaPanel)
# ============================================================
# Copie este arquivo como .env na raiz do projeto no servidor
# e preencha com seus valores reais.

# Banco de dados MySQL (aaPanel)
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=mysql://netplay_user:SUA_SENHA@localhost:3306/netplay_db

# Porta da API (aaPanel usa porta 83)
PORT=83

# Supabase Auth (autenticação de usuários)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_supabase

# TMDB — The Movie Database
VITE_TMDB_API_KEY=sua_chave_tmdb

# Google Gemini AI (tradução de sinopses)
VITE_GEMINI_API_KEY=sua_chave_gemini

# Terabox (resolvedores de stream)
TERABOX_PRO_API_KEY=sua_chave_terabox_pro
TERABOX_V2_API_KEY=sua_chave_terabox_v2
TERABOX_V3_API_KEY=sua_chave_terabox_v3
TERABOX_V3_API_SECRET=seu_secret_terabox_v3

# Notificações Push (opcional)
VITE_ONESIGNAL_APP_ID=seu_app_id_onesignal

# Mercado Pago (opcional)
VITE_MERCADO_PAGO_PUBLIC_KEY=sua_chave_publica_mercado_pago
